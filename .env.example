APP_ENV=local
APP_NAME=NEPSE AI Trading Research Platform
APP_VERSION=0.1.0

SECRET_KEY=change_me_in_local_env
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=postgresql+psycopg://nepse:change_me@localhost:5432/nepse_ai
REDIS_URL=redis://localhost:6379/0
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_PREFIX=

NEPSE_PRIMARY_DATA_SOURCE_URL=
NEPSE_BACKUP_DATA_SOURCE_URL=
DATA_TRUST_SCORE_MINIMUM=0.90
# Database connection pool (ignored for SQLite)
DATABASE_POOL_SIZE=10

# Holiday calendar (optional)
CALENDARIFIC_API_KEY=
CALENDARIFIC_COUNTRY=NP
CALENDARIFIC_NATIONAL_ONLY=false
