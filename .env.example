APP_ENV=local
APP_NAME=NEPSE AI Trading Research Platform
APP_VERSION=0.1.0

SECRET_KEY=change_me_in_local_env
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=postgresql+psycopg://nepse:change_me@localhost:5432/nepse_ai
REDIS_URL=redis://localhost:6379/0
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_PREFIX=

NEPSE_PRIMARY_DATA_SOURCE_URL=
NEPSE_BACKUP_DATA_SOURCE_URL=
DATA_TRUST_SCORE_MINIMUM=0.90
# Database connection pool (ignored for SQLite)
DATABASE_POOL_SIZE=10

# Holiday calendar (optional)
CALENDARIFIC_API_KEY=
CALENDARIFIC_COUNTRY=NP
CALENDARIFIC_NATIONAL_ONLY=false

# ---------------------------------------------------------------------------
# External research-data providers (advisory only; never trigger live trading)
# All providers are OPT-IN. Leaving keys blank and *_ENABLED=false means the
# system makes ZERO external API calls. Enable a provider only after adding its
# key. Do NOT commit real keys.
# ---------------------------------------------------------------------------

# Set true ONLY to run opt-in live integration tests against real providers.
EXTERNAL_API_LIVE_TESTS=false

# FRED — macro series (rates, inflation, unemployment, GDP)
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org
FRED_RATE_LIMIT_PER_MINUTE=60
FRED_DEFAULT_SERIES=DGS10,DGS2,DFF,CPIAUCSL,UNRATE,GDP
FRED_ENABLED=false

# NewsAPI — financial headlines for sentiment
NEWSAPI_API_KEY=
NEWSAPI_BASE_URL=https://newsapi.org
NEWSAPI_RATE_LIMIT_PER_MINUTE=30
NEWSAPI_ENABLED=false

# Hugging Face — optional hosted NLP enrichment
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co
HUGGINGFACE_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
HUGGINGFACE_RATE_LIMIT_PER_MINUTE=30
HUGGINGFACE_ENABLED=false

# Marketstack — global OHLCV / benchmark context
MARKETSTACK_API_KEY=
MARKETSTACK_BASE_URL=https://api.marketstack.com
MARKETSTACK_RATE_LIMIT_PER_MINUTE=30
MARKETSTACK_ENABLED=false

# Finnhub — candles, fundamentals, earnings
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io
FINNHUB_RATE_LIMIT_PER_MINUTE=30
FINNHUB_ENABLED=false

# Context.dev — enriched market context / entity extraction
CONTEX_DEV_ENABLED=false
# NOTE: the API key env var is named "CONTEX.DEV" (with a dot) as required by the provider.
CONTEX.DEV=
CONTEX_BASE_URL=https://api.context.dev/

# Optional scale providers (disabled by default)
POLYGON_API_KEY=
POLYGON_ENABLED=false
IEXCLOUD_API_KEY=
IEXCLOUD_ENABLED=false
COINGECKO_ENABLED=false
FIXER_API_KEY=
FIXER_ENABLED=false
EXCHANGERATE_HOST_ENABLED=false
